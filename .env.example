# Copy to .env. Never commit real keys.
# mock | gemini
VIVA_LLM=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
# Daemon port, shared by the pre-push hook and the web UI proxy.
VIVA_PORT=4317
# Exposed to the browser, so use a public agent ID only.
VITE_ELEVENLABS_AGENT_ID=
